
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CottonConnect | Dashboard</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#edf3fa;color:#102c52}
.top{height:78px;background:#102f63;color:white;display:flex;align-items:center;justify-content:space-between;padding:0 24px}
.brand{font-size:25px;font-weight:bold}
.brand small{display:block;font-size:14px;font-weight:normal;margin-top:5px}
.layout{display:flex;min-height:calc(100vh - 78px)}
nav{width:225px;flex-shrink:0;background:#0b2347;padding:18px 10px}
nav button{width:100%;padding:15px 12px;text-align:left;background:transparent;border:0;color:white;border-radius:8px;font-size:15px;cursor:pointer;margin-bottom:5px}
nav button:hover,nav button.active{background:#2170e8}
main{flex:1;min-width:0;padding:22px}
.welcome{padding:28px 30px;background:linear-gradient(110deg,#e5f1ff,#b4d8f6);border-radius:14px;border-bottom:10px solid #9bc4a6;margin-bottom:17px}
.welcome h1{margin:0 0 10px;font-size:27px}
.welcome p{margin:0;font-size:16px}
.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:18px}
.card,.panel,.quick{background:white;border:1px solid #dce5f0;border-radius:13px;padding:20px;box-shadow:0 4px 12px #17385b0c}
.card:nth-child(1){background:#e5efff}
.card:nth-child(2){background:#e3f6e9}
.card:nth-child(3){background:#efe8fb}
.card:nth-child(4){background:#fff0df}
.card .label{font-size:14px;color:#627995}
.card .value{font-size:25px;font-weight:bold;margin:10px 0}
.middle{display:grid;grid-template-columns:1.5fr 1fr;gap:17px}
h3{margin:0 0 20px;font-size:18px}
.chart{width:100%;height:auto;display:block}
.legend{display:flex;gap:18px;font-size:14px;margin-bottom:10px}
.dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:6px}
.stock-layout{display:flex;align-items:center;justify-content:center;gap:22px;flex-wrap:wrap}
.donut{width:150px;height:150px;border-radius:50%;background:conic-gradient(#2478e8 0 63%,#22a75a 63% 88%,#f59b38 88% 100%);display:grid;place-items:center}
.donut div{background:white;width:90px;height:90px;border-radius:50%;display:grid;place-items:center;text-align:center;font-weight:bold}
.stock-legend p{margin:13px 0;font-size:14px}
.bottom{display:grid;grid-template-columns:1fr 1fr;gap:17px;margin-top:18px}
.quick{margin-top:18px}
.actions{display:flex;gap:10px;flex-wrap:wrap}
.actions button{border:0;border-radius:7px;background:#2170e8;color:white;padding:12px 17px;font-weight:bold;cursor:pointer}
.actions button:nth-child(2){background:#22a75a}
.actions button:nth-child(3){background:#7955db}
.actions button:nth-child(4){background:#f49a38}
.actions button:nth-child(5){background:#7b8da7}
table{width:100%;border-collapse:collapse;font-size:14px}
th,td{padding:12px 8px;border-bottom:1px solid #e6edf5;text-align:left}
th{color:#627995}
.page{display:none}
.page.active{display:block}
.formrow{margin:12px 0}
.formrow label{display:block;margin-bottom:5px}
.formrow input,.formrow select{padding:10px;width:100%;border:1px solid #ccd6e3;border-radius:6px}
.message{margin-top:12px;color:#147b43}
@media(max-width:950px){.cards{grid-template-columns:repeat(2,minmax(0,1fr))}.middle,.bottom{grid-template-columns:1fr}}
@media(max-width:600px){.top{padding:14px;height:auto}.brand{font-size:20px}#today{display:none}.layout{display:block}nav{width:100%;display:flex;overflow-x:auto;padding:8px}nav button{min-width:max-content;width:auto;padding:12px}main{padding:12px}.cards{gap:8px}.card{padding:13px}.card .value{font-size:19px}.welcome{padding:20px}.welcome h1{font-size:23px}}
</style>
</head>
<body>
<header class="top">
  <div class="brand">☁ CottonConnect<small>Cotton Purchasing and Selling System</small></div>
  <div id="today">28 Oct 2026 &nbsp; | &nbsp; Admin</div>
</header>
<div class="layout">
<nav>
<button class="active" data-page="dashboard">🏠 Dashboard</button>
<button data-page="suppliers">🏭 Suppliers</button>
<button data-page="customers">👥 Customers</button>
<button data-page="purchase">🛒 Purchase</button>
<button data-page="sales">🧾 Sales</button>
<button data-page="stock">📦 Stock</button>
<button data-page="reports">📊 Reports</button>
<button data-page="settings">⚙ Settings</button>
</nav>
<main>
<section class="page active" id="dashboard">
<div class="welcome"><h1>Welcome to CottonConnect</h1><p>Manage your cotton business efficiently.</p></div>
<div class="cards">
<div class="card"><div class="label">🛒 Total Purchases</div><div class="value">₹ 2,78,450</div><div class="label">This month</div></div>
<div class="card"><div class="label">💰 Total Sales</div><div class="value">₹ 2,47,800</div><div class="label">This month</div></div>
<div class="card"><div class="label">📦 Total Stock</div><div class="value">3,870 kg</div><div class="label">Available</div></div>
<div class="card"><div class="label">👥 Total Suppliers</div><div class="value" id="supplierCount">5</div><div class="label">Registered</div></div>
</div>
<div class="middle">
<div class="panel"><h3>Purchase &amp; Sales Overview</h3>
<div class="legend"><span><i class="dot" style="background:#2478e8"></i>Purchase</span><span><i class="dot" style="background:#22a75a"></i>Sales</span></div>
<svg class="chart" viewBox="0 0 520 230" role="img" aria-label="Sample purchase and sales line chart">
<g stroke="#e3ebf5" stroke-width="1"><path d="M48 25H505 M48 70H505 M48 115H505 M48 160H505 M48 205H505"/></g>
<g fill="#657d98" font-size="10"><text x="2" y="28">300k</text><text x="2" y="73">225k</text><text x="2" y="118">150k</text><text x="2" y="163">75k</text><text x="25" y="208">0</text></g>
<polyline fill="none" stroke="#2478e8" stroke-width="3" points="48,130 98,115 148,99 198,88 248,80 298,63 348,49 398,35 448,27 500,22"/>
<polyline fill="none" stroke="#22a75a" stroke-width="3" points="48,126 98,110 148,94 198,82 248,75 298,57 348,42 398,28 448,19 500,48"/>
<g fill="#2478e8"><circle cx="48" cy="130" r="3"/><circle cx="98" cy="115" r="3"/><circle cx="148" cy="99" r="3"/><circle cx="198" cy="88" r="3"/><circle cx="248" cy="80" r="3"/><circle cx="298" cy="63" r="3"/><circle cx="348" cy="49" r="3"/><circle cx="398" cy="35" r="3"/><circle cx="448" cy="27" r="3"/><circle cx="500" cy="22" r="3"/></g>
<g fill="#657d98" font-size="10" text-anchor="middle"><text x="48" y="224">Jan</text><text x="98" y="224">Feb</text><text x="148" y="224">Mar</text><text x="198" y="224">Apr</text><text x="248" y="224">May</text><text x="298" y="224">Jun</text><text x="348" y="224">Jul</text><text x="398" y="224">Aug</text><text x="448" y="224">Sep</text><text x="500" y="224">Oct</text></g>
</svg></div>
<div class="panel"><h3>Stock Distribution</h3><div class="stock-layout"><div class="donut"><div>3,870 kg<br><small>Total Stock</small></div></div><div class="stock-legend"><p>🔵 Raw Cotton &nbsp; 63%</p><p>🟢 Processed Cotton &nbsp; 25%</p><p>🟠 Cotton Bales &nbsp; 12%</p></div></div></div>
</div>
<div class="bottom">
<div class="panel"><h3>Recent Purchases</h3><table><thead><tr><th>Supplier</th><th>Quantity</th><th>Amount</th></tr></thead><tbody id="purchases"><tr><td>Sample Supplier</td><td>500 kg</td><td>₹35,000</td></tr></tbody></table></div>
<div class="panel"><h3>Recent Sales</h3><table><thead><tr><th>Customer</th><th>Quantity</th><th>Amount</th></tr></thead><tbody id="sales"><tr><td>Sample Customer</td><td>300 kg</td><td>₹42,000</td></tr></tbody></table></div>
</div>
<div class="quick"><h3>Quick Actions</h3><div class="actions"><button data-page="suppliers">+ Add Supplier</button><button data-page="customers">+ Add Customer</button><button data-page="purchase">New Purchase</button><button data-page="sales">New Sale</button><button data-page="reports">View Reports</button></div></div>
</section>

<section class="page" id="suppliers"><div class="panel"><h3>Register Supplier</h3><form id="supplierForm"><div class="formrow"><label>Supplier name</label><input id="supplierName" required></div><div class="formrow"><label>Phone</label><input id="supplierPhone"></div><div class="formrow"><label>Address</label><input id="supplierAddress"></div><button class="actions button" type="submit">Save Supplier</button><p id="supplierMessage" class="message"></p></form><table><thead><tr><th>Name</th><th>Phone</th><th>Address</th></tr></thead><tbody id="supplierRows"></tbody></table></div></section>

<section class="page" id="customers"><div class="panel"><h3>Register Customer</h3><form id="customerForm"><div class="formrow"><label>Customer name</label><input id="customerName" required></div><div class="formrow"><label>Phone</label><input id="customerPhone"></div><div class="formrow"><label>Address</label><input id="customerAddress"></div><button type="submit">Save Customer</button><p id="customerMessage" class="message"></p></form><table><thead><tr><th>Name</th><th>Phone</th><th>Address</th></tr></thead><tbody id="customerRows"></tbody></table></div></section>

<section class="page" id="purchase"><div class="panel"><h3>New Purchase</h3><form id="purchaseForm"><div class="formrow"><label>Supplier</label><input id="purchaseSupplier" required></div><div class="formrow"><label>Quantity (kg)</label><input id="purchaseQty" type="number" min="0.01" step="0.01" required></div><div class="formrow"><label>Rate per kg (₹)</label><input id="purchaseRate" type="number" min="0" step="0.01" required></div><button type="submit">Record Purchase</button><p id="purchaseMessage" class="message"></p></form></div></section>

<section class="page" id="sales"><div class="panel"><h3>New Sale</h3><form id="saleForm"><div class="formrow"><label>Customer</label><input id="saleCustomer" required></div><div class="formrow"><label>Quantity (kg)</label><input id="saleQty" type="number" min="0.01" step="0.01" required></div><div class="formrow"><label>Rate per kg (₹)</label><input id="saleRate" type="number" min="0" step="0.01" required></div><button type="submit">Record Sale</button><p id="saleMessage" class="message"></p></form></div></section>

<section class="page" id="stock"><div class="panel"><h3>Stock Management</h3><p>Sample available stock: <strong id="stockValue">3,870 kg</strong></p><p>Stock changes in this demo are stored only in this browser.</p></div></section>
<section class="page" id="reports"><div class="panel"><h3>Business Reports</h3><p>Sample total purchases: ₹2,78,450</p><p>Sample total sales: ₹2,47,800</p><p>Sample stock: 3,870 kg</p><button id="downloadReport">Download CSV Report</button></div></section>
<section class="page" id="settings"><div class="panel"><h3>Settings</h3><p>CottonConnect — Cotton Purchasing and Selling System</p><p>This is a static demonstration website.</p></div></section>
</main>
</div>
<script>
const $=id=>document.getElementById(id);
function showPage(id){document.querySelectorAll('.page').forEach(p=>p.classList.toggle('active',p.id===id));document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===id));window.scrollTo(0,0)}
document.querySelectorAll('[data-page]').forEach(b=>b.addEventListener('click',()=>showPage(b.dataset.page)));
function read(key){try{return JSON.parse(localStorage.getItem('cotton_'+key)||'[]')}catch{return []}}
function save(key,items){localStorage.setItem('cotton_'+key,JSON.stringify(items))}
function cell(text){const td=document.createElement('td');td.textContent=text;return td}
function addRow(id,values){const tr=document.createElement('tr');values.forEach(v=>tr.appendChild(cell(v)));$(id).prepend(tr)}
function setupPeople(type){const form=$(type+'Form');form.addEventListener('submit',e=>{e.preventDefault();const prefix=type==='supplier'?'supplier':'customer';const name=$(prefix+'Name').value.trim();const phone=$(prefix+'Phone').value.trim();const address=$(prefix+'Address').value.trim();const data=read(type);data.push({name,phone,address});save(type,data);renderPeople(type);$(type+'Message').textContent=type==='supplier'?'Supplier saved in this browser.':'Customer saved in this browser.';form.reset()})}
function renderPeople(type){const prefix=type==='supplier'?'supplier':'customer';const tbody=$(type==='supplier'?'supplierRows':'customerRows');tbody.replaceChildren();read(type).forEach(p=>{const tr=document.createElement('tr');[p.name,p.phone,p.address].forEach(v=>tr.appendChild(cell(v)));tbody.appendChild(tr)});if(type==='supplier')$('supplierCount').textContent=5+read('supplier').length}
setupPeople('supplier');setupPeople('customer');renderPeople('supplier');renderPeople('customer');
function setupTransaction(type){$(type+'Form').addEventListener('submit',e=>{e.preventDefault();const isPurchase=type==='purchase';const who=$(isPurchase?'purchaseSupplier':'saleCustomer').value.trim();const qty=Number($(isPurchase?'purchaseQty':'saleQty').value);const rate=Number($(isPurchase?'purchaseRate':'saleRate').value);if(!who||qty<=0||rate<0)return;const list=read(type);list.unshift({who,qty,amount:qty*rate});save(type,list);const tbody=$(isPurchase?'purchases':'sales');tbody.replaceChildren();list.forEach(t=>{const tr=document.createElement('tr');[t.who,t.qty+' kg','₹'+t.amount.toLocaleString('en-IN',{maximumFractionDigits:2})].forEach(v=>tr.appendChild(cell(v)));tbody.appendChild(tr)});$(type+'Message').textContent='Transaction saved in this browser demo.';e.target.reset()})}
setupTransaction('purchase');setupTransaction('sale');
function loadTransactions(type){const tbody=$(type==='purchase'?'purchases':'sales');read(type).forEach(t=>{const tr=document.createElement('tr');[t.who,t.qty+' kg','₹'+t.amount.toLocaleString('en-IN',{maximumFractionDigits:2})].forEach(v=>tr.appendChild(cell(v)));tbody.appendChild(tr)})}
loadTransactions('purchase');loadTransactions('sale');
$('downloadReport').addEventListener('click',()=>{const rows=[['Type','Name','Quantity kg','Amount INR'],...['purchase','sale'].flatMap(type=>read(type).map(t=>[type,t.who,t.qty,t.amount]))];const csv=rows.map(r=>r.map(v=>'"'+String(v).replaceAll('"','""')+'"').join(',')).join('\r\n');const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));a.download='cottonconnect-report.csv';a.click();URL.revokeObjectURL(a.href)});
$('today').textContent=new Date().toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'})+' | Admin';
</script>
</body>
</html>
